#include<iostream>
using namespace std;
int linearsearch(int arr[], int size, int target)
{
for(int i=0; i<size; i++)
{
    if(arr[i] == target)
    return i;
}
           return -1;
}

int main()
{
int arr[]={1, 3, 5, 7, 9};
int size = sizeof(arr) / sizeof(arr[0]);
int target = 5;
int result = linearsearch(arr, size, target);
if(result != -1)
{
    cout<<"Element Found at Index: "<<result <<endl;
}
else
     cout<<"Element Not Found: ";
    return 0;
}
